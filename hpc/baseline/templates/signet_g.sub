#!/bin/bash
#SBATCH --job-name=signet_g
# --output/--error come from submit_step.sh: #SBATCH lines cannot expand $FIXTURE_DIR.
# Partition, account, CPUs, memory and time also come from the sbatch command line.
# shellcheck source=common.sh
source "$BASELINE_DIR/templates/common.sh"
baseline_start g
prepare_signet
signet_args
in_container ./signet -g --ncores "${SLURM_CPUS_PER_TASK:-1}" "${SIGNET_EXTRA[@]}"
baseline_end $?
