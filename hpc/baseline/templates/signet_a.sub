#!/bin/bash
#SBATCH --job-name=signet_a
# --output/--error come from submit_step.sh: #SBATCH lines cannot expand $FIXTURE_DIR.
# Partition, account, CPUs, memory and time also come from the sbatch command line.
# shellcheck source=common.sh
source "$BASELINE_DIR/templates/common.sh"
baseline_start a
prepare_signet
signet_args
# script/adj/adj.sh asks "Enter the number of PCs" with read -p; batch jobs have no terminal.
case "${PC_ANSWER_MODE:-stdin}" in
    stdin)
        echo "[BASELINE] PC_ANSWER_MODE=stdin NPC=${NPC:-3}"
        echo "${NPC:-3}" | in_container ./signet -a "${SIGNET_EXTRA[@]}";;
    none)
        echo "[BASELINE] PC_ANSWER_MODE=none (stdin left as Slurm provides it)"
        in_container ./signet -a "${SIGNET_EXTRA[@]}";;
    *)
        echo "[BASELINE] unknown PC_ANSWER_MODE=$PC_ANSWER_MODE" >&2
        baseline_end 2;;
esac
baseline_end $?
