# Copy to env.sh (git-ignored) on HPC3 and fill in. Sourced by every baseline script and job.
# shellcheck shell=bash

# SIGNET install; must be the commit pinned in signet_inventory.json (bed55b3).
export SIGNET_DIR=/pub/$USER/SIGNET
# From `sacctmgr show assoc user=$USER format=account`.
export LAB_ACCOUNT=

# Container, relative to SIGNET_DIR (or absolute). Used by -g/-t/-a/-c and written to config sif.
export SIGNET_SIF=signet.sif

# Inputs that do not ship with SIGNET. Leave empty to mark the dependent step as blocked.
export SIGNET_REF_PREFIX=     # -g: imputation reference panel prefix, e.g. ref_panel_38/chr
export SIGNET_GMAP_PREFIX=    # -g: genetic map prefix, e.g. gmap/chr
export SIGNET_GTF=            # -t: gencode.v22.gene.gtf
export SIGNET_CLINICAL=       # -a: clinical file matching the example samples

# Environment from the SIGNET manual.
export PATH=$SIGNET_DIR:$PATH
export SINGULARITYENV_APPEND_PATH=$SIGNET_DIR
export SINGULARITY_BIND=$SIGNET_DIR

# Python 3 for the observers (stdlib only). Adjust to a module HPC3 provides (`module avail python`).
# module load python/3.10.2
