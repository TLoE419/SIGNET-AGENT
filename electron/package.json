{
  "name": "signet-electron-shell",
  "version": "0.1.0",
  "private": true,
  "description": "SIGNET desktop client with an independent Python backend",
  "main": "main/app/entry.cjs",
  "scripts": {
    "postinstall": "node scripts/prepare-node-pty.cjs",
    "start": "electron .",
    "test": "npm run typecheck && node --test tests/*.test.cjs && node --import tsx --test tests/ssh.test.ts tests/environment.test.ts tests/environment-verify.test.ts tests/runtime-modules.test.ts && node --import tsx --test tests/ui.test.tsx tests/model-ui.test.tsx tests/remote-readiness.test.tsx tests/dataset-files.test.tsx",
    "test:smoke": "electron tests/smoke.cjs",
    "test:workspace": "npm run build && electron tests/workspace.cjs",
    "test:dataset": "npm run build && electron tests/custom-dataset.cjs",
    "test:history": "npm run build && electron tests/history.cjs",
    "test:attempts": "npm run build && electron tests/attempts.cjs",
    "test:cancellation": "npm run build && electron tests/cancellation.cjs",
    "test:logs": "npm run build && electron tests/logs.cjs",
    "test:startup": "electron tests/startup.cjs",
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest:smoke": "npm run build",
    "pretest:startup": "npm run build",
    "dev": "npm run build && electron . --dev",
    "test:dev": "npm run build && electron tests/dev-terminal.cjs",
    "test:environment": "npm run build && electron tests/environment.cjs",
    "test:model-switch": "npm run build && electron tests/model-switch.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "21.1.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "electron": "44.9.3",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh2": "1.17.0"
  }
}
