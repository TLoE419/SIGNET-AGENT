{
  "name": "signet-electron-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Optional desktop host for the existing SIGNET Python web application",
  "main": "entry.cjs",
  "scripts": {
    "start": "electron .",
    "test": "npm run typecheck && node --test tests/*.test.cjs && node --import tsx --test tests/ssh.test.ts && node --import tsx --test tests/ui.test.tsx",
    "test:smoke": "electron tests/smoke.cjs",
    "test:startup": "electron tests/startup.cjs",
    "build": "node build-ssh.mjs",
    "prestart": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest:smoke": "npm run build",
    "pretest:startup": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "jsdom": "26.1.0",
    "@types/jsdom": "21.1.7",
    "@testing-library/react": "16.3.3"
  },
  "dependencies": {
    "ssh2": "1.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
