# Optional providers. Use your own credentials; keep .env out of Git.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model override for your signed-in Codex CLI.
SIGNET_CODEX_MODEL=

# Advanced scientific setup. Relative host paths resolve from this project.
# Default official source: .dependencies/official-signet
SIGNET_SOURCE=
# Default VM host directory: .dependencies/scientific-runtime
SIGNET_RUNTIME_PROJECT=
SIGNET_SSH_PORT=2226
# Absolute path INSIDE the VM, not a host file path.
SIGNET_CONTAINER_IMAGE=/work/evidence/signet-0.0.6.sif

# HPC3 connection (python3 hpc3_ssh.py check). Your UCInetID; no password is ever stored.
HPC3_USER=
# Default: hpc3.rcic.uci.edu
HPC3_HOST=
